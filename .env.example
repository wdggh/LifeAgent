# --- Application ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- Auth ---
JWT_SECRET=change-me-to-a-random-32-byte-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://lifeagent:lifeagent@localhost:5433/lifeagent

# --- Redis / ARQ worker ---
REDIS_URL=redis://localhost:6379/0
INGESTION_ENQUEUE_ENABLED=true
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_DELAY_SECONDS=2

# --- Chroma (standalone service) ---
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=lifeagent_text-embedding-v3_1024

# --- LLM (DeepSeek, OpenAI-compatible) ---
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Debug fallback: set LLM_PROVIDER=dashscope and use the DashScope key below.
QWEN_MODEL=qwen-max
APP_TIMEZONE=Asia/Shanghai

# --- Embedding (Alibaba DashScope, OpenAI-compatible mode) ---
EMBEDDING_PROVIDER=dashscope
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
DASHSCOPE_API_KEY=

# --- Uploads ---
UPLOAD_DIR=/data/uploads
MAX_FILE_SIZE_MB=50

# --- Agent budget ---
MAX_ITERATIONS=5
MAX_RETRIEVALS=3
TOP_K_DEFAULT=5
LLM_MAX_TOKENS=1500
STALE_PROCESSING_MINUTES=15

# --- Query rewrite (V2.1, experimental; default off after failed A/B) ---
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_SECONDS=8
QUERY_REWRITE_MAX_TOKENS=200

# --- Query expansion / multi-query retrieval (V2.2, ADR-0010) ---
QUERY_EXPANSION_ENABLED=false
QUERY_EXPANSION_VARIANTS=1
QUERY_EXPANSION_CANDIDATE_K=8
QUERY_EXPANSION_RRF_K=60
QUERY_EXPANSION_ORIGINAL_WEIGHT=1.0
QUERY_EXPANSION_TIMEOUT_SECONDS=8
QUERY_EXPANSION_MAX_TOKENS=200

# --- Sparse / hybrid retrieval (V2.3, ADR-0011) ---
QUERY_SPARSE_ENABLED=false
QUERY_SPARSE_CANDIDATE_K=8
QUERY_SPARSE_BM25_K1=1.5
QUERY_SPARSE_BM25_B=0.75
QUERY_SPARSE_RRF_K=60
QUERY_SPARSE_VERSION_TTL_SECONDS=60
QUERY_SPARSE_FUSION_MODE=equal_rrf
QUERY_SPARSE_RRF_WEIGHT_DENSE=2.0
QUERY_SPARSE_RESERVED_SLOTS=1
